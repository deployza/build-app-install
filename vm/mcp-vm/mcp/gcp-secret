#!/bin/bash
# gcp-secret <secret-id> — print a Secret Manager secret's latest value to stdout.
#
# Installed to /usr/local/bin/gcp-secret by build-ops/vm/mcp-vm/mcp.sh. Used by
# mcp-serve (the MCP API key), mcp-auth (the gateway's four secrets) and
# mcp-refresh (the read-only GitHub PAT).
#
# The value goes to STDOUT ONLY. Callers capture it into a shell variable and
# export it; nothing here writes it to disk, and nothing passes it as a command
# argument where `ps` would show it to any local user.
#
# DELIBERATELY NO `set -x`. Every other install/boot script in this repo traces,
# because their contents are not sensitive. This one's output IS the secret, and
# a traced line would copy it into the systemd journal and the GCE serial console
# — both readable by anyone with project-level log access. Do not add -x here.
set -euo pipefail

if [[ $# -ne 1 || -z "${1:-}" ]]; then
    echo "usage: gcp-secret <secret-id>" >&2
    exit 2
fi

secret_id="$1"

# The project is read from the metadata server rather than baked or passed in, so
# the same image works unmodified in any project. `gcloud config` is unset on a
# fresh VM, so it cannot be the source.
project="$(curl -fsS --max-time 5 -H 'Metadata-Flavor: Google' \
    http://metadata.google.internal/computeMetadata/v1/project/project-id)"

# gcloud authenticates as the VM's attached service account via the metadata
# server. Access is granted PER SECRET in Terraform (build-terraform
# dz-builds/secrets.tf), not project-wide, so this fails closed on any secret the
# mcp-vm-sa SA was not explicitly given.
exec gcloud secrets versions access latest \
    --secret="$secret_id" \
    --project="$project"
