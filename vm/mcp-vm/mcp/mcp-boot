#!/bin/bash
# -----------------------------------------------------------------------------
# mcp-boot — per-instance provisioning, run once per boot by
# mcp-boot.service before the server and refresh units start.
#
# Installed to /usr/local/bin/mcp-boot by build-ops/vm/mcp-vm/mcp.sh. It is the
# one boot-time unit this fleet still has, because everything it touches is
# per-instance state. It provisions the host only — it was pushed over SSH like
# the rest of the app, and pulls nothing at boot.
#
#   1. /data — a directory on the boot disk, or a mounted disk if one is attached
#   2. a 2 GB swapfile in it
#   3. the service user's HOME on it — mandatory, see setup_service_home
#   4. any one-shot migration not yet applied to this /data
#
# It deliberately does NOT install software and does NOT start the other units.
# The venv is baked by the image and everything else is installed by mcp.sh;
# start-up ordering is systemd's job — mcp.service, mcp-auth.service and
# mcp-refresh.service all declare Requires=/After= on mcp-boot.service, so they
# run once this succeeds and not at all if it fails.
#
# Runs on EVERY boot, so every step is idempotent. mcp.sh also runs it directly
# on each deploy to a VM that has already booted, so a migration shipped with a
# push applies at once rather than at the next reboot.
#
# Logs: sudo journalctl -u mcp-boot.service -b
# -----------------------------------------------------------------------------
set -euxo pipefail

log() { echo "[mcp-boot] $*"; }

# DATA_DEV is only used when a disk IS attached — it must then match the
# attached_disk device_name in build-terraform (builds/vms.tf). Normally no such
# disk exists. The rest match the paths in /etc/mcp/mcp.env.
readonly DATA_DEV="/dev/disk/by-id/google-mcp-data"
readonly DATA_MNT="/data"
readonly SVC_USER="mcp"
readonly SVC_HOME="/data/mcp"
readonly REPOS_DIR="/data/repos"
readonly AUTH_DIR="/data/mcp/auth"
readonly SWAPFILE="/data/swapfile"
readonly SWAP_SIZE="2G"
# One line per applied migration. Now on the boot disk with the rest of /data, so
# it resets on an image swap — harmless, because the state a migration would fix
# is reset at the same moment and rebuilt by the next refresh.
readonly MIGRATIONS="/data/mcp/.migrations"

# =============================================================================
# 1. Data area
# =============================================================================
#
# /data normally lives on the BOOT DISK — a plain directory, no second volume.
# The boot disk is 20 GB because GCE refuses one smaller than the image, and the
# OS plus venv use ~2.7 GB of it, so there is ~12 GB spare for clones, graphs and
# swap. A dedicated disk bought nothing but a resource to manage, a device-name
# contract between two repos, and a zonal volume that could not follow the VM
# across regions.
#
# THE TRADE: /data is destroyed with the boot disk on an image swap, so a
# replacement re-indexes from scratch. Measured at ~12 min of CPU for the whole
# org, which is cheap against the complexity it removes.
#
# A separate disk is still SUPPORTED. Attach one as device_name "mcp-data" and it
# is formatted and mounted exactly as before — so this image runs with or without
# it, and neither repo has to deploy in lockstep with the other.
setup_data_area() {
    if [[ ! -b "$DATA_DEV" ]]; then
        log "no data disk attached — using ${DATA_MNT} on the boot disk"
        mkdir -p "$DATA_MNT"
        return
    fi

    log "data disk present at ${DATA_DEV} — formatting/mounting it"

    # blkid is the guard against reformatting a disk that already holds the
    # graph: it succeeds only once a filesystem is present. Never add -F to the
    # mkfs below — that would defeat this check on any disk blkid cannot read.
    if ! blkid "$DATA_DEV" >/dev/null 2>&1; then
        log "no filesystem on ${DATA_DEV} — formatting (first boot)"
        mkfs.ext4 -m 0 -E lazy_itable_init=0,lazy_journal_init=0,discard "$DATA_DEV"
    fi

    mkdir -p "$DATA_MNT"

    # Recorded by UUID, not by the by-id path: that path depends on the attached
    # disk's device_name, and a mismatch would mount the wrong volume silently.
    # nofail keeps a missing disk from dropping the box into emergency mode,
    # where even IAP SSH cannot reach it to fix the problem.
    local uuid
    uuid="$(blkid -s UUID -o value "$DATA_DEV")"
    if ! grep -q "^UUID=${uuid} " /etc/fstab; then
        echo "UUID=${uuid} ${DATA_MNT} ext4 discard,defaults,nofail 0 2" >> /etc/fstab
        # Let systemd regenerate its fstab-derived mount units so later boots and
        # `systemctl status data.mount` agree with what is actually mounted.
        systemctl daemon-reload
    fi

    mountpoint -q "$DATA_MNT" || mount "$DATA_MNT"
}

# =============================================================================
# 2. Swap
# =============================================================================
#
# A cushion, not a crutch. On the measured numbers (72 MB peak across 22 repos,
# ~300 MB projected at ~200) it should never be touched — it exists so an
# unexpectedly large merge degrades into slowness instead of an OOM kill.
#
# Lives in /data. On the boot disk by default; measured usage never reaches it.
setup_swap() {
    if [[ ! -f "$SWAPFILE" ]]; then
        log "creating ${SWAP_SIZE} swapfile at ${SWAPFILE}"
        # fallocate leaves no holes on ext4, which swapon requires.
        fallocate -l "$SWAP_SIZE" "$SWAPFILE"
        chmod 600 "$SWAPFILE"
        mkswap "$SWAPFILE"
    fi

    grep -q "^${SWAPFILE} " /etc/fstab \
        || echo "${SWAPFILE} none swap sw 0 0" >> /etc/fstab

    swapon --show=NAME --noheadings | grep -qx "$SWAPFILE" \
        || swapon "$SWAPFILE"
}

# =============================================================================
# 3. Service user's home
# =============================================================================
#
# NOT optional and NOT arbitrary. graphify's `global add` writes to
# Path.home()/".graphify" — hardcoded upstream, with no flag to redirect it.
# mcp.sh creates the user with --home /data/mcp --no-create-home
# precisely so the directory is made here, at boot. `.graphify` is upstream's
# hardcoded name and stays as it is.
setup_service_home() {
    mkdir -p "${SVC_HOME}/.graphify" "$REPOS_DIR" "$AUTH_DIR"
    chown -R "${SVC_USER}:${SVC_USER}" "$SVC_HOME" "$REPOS_DIR"
    chmod 750 "$SVC_HOME"

    # The clone tree must be writable by the service user: graphify writes
    # graphify-out/ INTO each scanned repo, not into the working directory.
    chmod 750 "$REPOS_DIR"

    # The OAuth gateway's store: dynamic client registrations and the upstream
    # Google tokens, encrypted at rest by FastMCP. 700, not 750 like the rest — no
    # other account on this box has any business reading it. It is also why
    # mcp-auth.service is the one unit with a ReadWritePaths= exception to
    # ReadOnlyPaths=/data.
    #
    # ON THE BOOT DISK, like the rest of /data. An image swap therefore discards
    # every registration and every issued token, and each developer logs in through
    # the browser once more. That is a re-login, not data loss, and it is the
    # accepted cost of the single-disk design — see mcp.md's disk section.
    chmod 700 "$AUTH_DIR"
}

# =============================================================================
# 4. One-shot data-disk migrations
# =============================================================================
#
# WHY THIS EXISTS. A change to what the software indexes cannot, on its own,
# reach state already in /data — the clones, the graphs and the watermark
# outlive every deploy (and, with an attached data disk, every image swap too).
# A migration makes that fix part of the code that needs it, applied the same
# way on every VM, rather than a manual step someone has to remember over SSH.
#
# A migration is a named line in $MIGRATIONS. Adding a new one is: pick a name
# that will never be reused, and put its body behind `if needs_migration <name>`.

# needs_migration <name>: true exactly once per data disk, then never again.
# The stamp is written BEFORE the body runs, deliberately — a migration that
# fails half-way must not re-run on every subsequent boot and wedge the box in a
# loop. The failure is visible in the journal; a retry is a human decision.
needs_migration() {
    local name="$1"
    if [[ -f "$MIGRATIONS" ]] && grep -qxF "$name" "$MIGRATIONS"; then
        return 1
    fi
    echo "$name" >> "$MIGRATIONS"
    chown "${SVC_USER}:${SVC_USER}" "$MIGRATIONS"
    chmod 640 "$MIGRATIONS"
    return 0
}

apply_migrations() {
    # md-indexing-v1 (image 1-2). The refresh gained a Markdown pass, so every
    # repo's *.md now belongs in the graph — but Gate 1 only rescans repos whose
    # GitHub pushed_at is newer than the watermark. Every repo already cloned
    # here is unchanged, so without this the Markdown pass would run over nothing:
    # each repo would keep its code-only subgraph until someone happened to push
    # to it, and a quiet repo would never gain its docs at all. `build-docs`,
    # newly un-excluded, would not even be cloned.
    #
    # Clearing the watermark makes the next refresh treat every repo as changed —
    # one full pass (~5 min of CPU, clones already present), once.
    if needs_migration "md-indexing-v1"; then
        log "migration md-indexing-v1: clearing the refresh watermark so the"
        log "  next run re-indexes every repo and picks up Markdown"
        rm -f "${SVC_HOME}/last-run"
    fi
}

# =============================================================================
# Main
# =============================================================================
main() {
    setup_data_area
    setup_swap
    setup_service_home
    apply_migrations
    log "per-instance provisioning complete; systemd starts the units from here"
}

main "$@"
